{
  "name": "motion-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:vision": "node scripts/prepare-vision.mjs",
    "predev": "npm run assets:vision",
    "prebuild": "npm run assets:vision",
    "dev": "vite --host localhost --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview --host localhost --port 5173 --strictPort"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mediapipe/tasks-vision": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0"
  }
}
